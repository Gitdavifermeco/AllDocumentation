		SummonRainBeam()
		
	elseif Key == Enum.KeyCode.F --[[and HasPeri("Rainbow")]]  then
		RainbowNova()
		
	elseif Key == Enum.KeyCode.C then
		RainbowMeteorShower()
		RainbowComet()
		
	elseif Key == Enum.KeyCode.V --[[and HasPeri("Azure")]] then 
		Rainboom()
		RainbowDefence()
		RainbowStar()
		
